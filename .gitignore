# .gitignore for VHDDSwitch (.NET / C# / Windows)

# Build results and binaries
bin/
obj/
build/
dist/
out/
*.exe
*.dll
*.pdb
*.msi
*.iso

# Exception: Keep release executables if explicitly placed in release distribution folder
!dist/*.exe

# Visual Studio / Visual Studio Code
.vs/
.vscode/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs

# JetBrains Rider / Resharper
.idea/
*.DotSettings.user

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Temporary and log files
*.log
*.tmp
*.bak
*.cache
temp/
logs/
.workspace/*
