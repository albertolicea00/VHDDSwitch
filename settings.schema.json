{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "type":  "object",
    "required":  [
                     "app",
                     "profiles"
                 ],
    "properties":  {
                       "app":  {
                                   "type":  "object",
                                   "required":  [
                                                    "theme",
                                                    "refreshIntervalSeconds",
                                                    "minimizeToTray",
                                                    "requireAdminOnStartup"
                                                ],
                                   "properties":  {
                                                      "theme":  {
                                                                    "enum":  [
                                                                                 "System",
                                                                                 "Light",
                                                                                 "Dark"
                                                                             ]
                                                                },
                                                      "refreshIntervalSeconds":  {
                                                                                     "type":  "integer",
                                                                                     "minimum":  2,
                                                                                     "maximum":  3600
                                                                                 },
                                                      "minimizeToTray":  {
                                                                             "type":  "boolean"
                                                                         },
                                                      "requireAdminOnStartup":  {
                                                                                    "const":  true
                                                                                }
                                                  }
                               },
                       "profiles":  {
                                        "type":  "array",
                                        "minItems":  1,
                                        "items":  {
                                                      "type":  "object",
                                                      "required":  [
                                                                       "id",
                                                                       "name",
                                                                       "expectedBays"
                                                                   ],
                                                      "properties":  {
                                                                         "id":  {
                                                                                    "type":  "string",
                                                                                    "minLength":  1
                                                                                },
                                                                         "name":  {
                                                                                      "type":  "string",
                                                                                      "minLength":  1
                                                                                  },
                                                                         "hardwareFilter":  {
                                                                                                "type":  "string",
                                                                                                "minLength":  1
                                                                                            },
                                                                         "expectedBays":  {
                                                                                              "type":  "integer",
                                                                                              "minimum":  1,
                                                                                              "maximum":  64
                                                                                          },
                                                                         "referenceLetters":  {
                                                                                                  "type":  "array",
                                                                                                  "items":  {
                                                                                                                "type":  "string",
                                                                                                                "pattern":  "^[A-Za-z]$"
                                                                                                            }
                                                                                              },
                                                                         "autoMountOnDetect":  {
                                                                                                   "type":  "boolean"
                                                                                               },
                                                                         "members":  {
                                                                                         "uniqueItems":  true,
                                                                                         "items":  {
                                                                                                       "minLength":  1,
                                                                                                       "type":  "string"
                                                                                                   },
                                                                                         "type":  "array"
                                                                                     },
                                                                         "allExternal":  {
                                                                                             "type":  "boolean"
                                                                                         }
                                                                     }
                                                  }
                                    }
                   }
}
